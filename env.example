# occams-agentic — Optional API Keys
#
# Only ONE script needs an external key: analyze-video.py (video analysis fallback).
# If your model supports video natively, you don't need any keys at all.
#
# Setup:
#   1. mkdir -p ~/.config/secrets
#   2. cp -n env.example ~/.config/secrets/env   # -n won't overwrite existing
#   3. Edit ~/.config/secrets/env — uncomment and fill keys you need
#   4. chmod 600 ~/.config/secrets/env
#   5. Add to shell profile (once):
#      printf '\n[ -f "$HOME/.config/secrets/env" ] && . "$HOME/.config/secrets/env"\n' >> ~/.profile
#   6. source ~/.profile

# ── Video Analysis (optional) ──────────────────────────────────────────
# Used by analyze-video.py (OpenRouter → Gemini). Only needed if you want
# script-based video analysis instead of native model capabilities.
# export OPENROUTER_API_KEY="sk-or-v1-..."
