#!/usr/bin/env bash
# transcribe — speech-to-text using whisper.cpp (local, GPU-accelerated)
#
# Converts speech in audio/video files to text with timestamps.
# Videos are auto-extracted to 16kHz mono WAV before transcription.
# Outputs SRT by default; pass whisper-cli flags for other formats.
#
# whisper.cpp is built via nix from kotur-nixpkgs (local clone or GitHub).
# Model: ggml-large-v3-turbo (1.6 GB, auto-downloaded if missing, cached in ~/.local/share/occams-agentic/models/whisper/).
#
# GPU backends:
#   Linux: Vulkan (auto-detects AMD/NVIDIA/Intel ICD). Override via VK_ICD_FILENAMES.
#   macOS: CoreML/Metal (whisper.cpp uses it automatically).
#
# Usage:
#   transcribe lecture.mp4                                    # auto lang, SRT
#   transcribe lecture.mp4 --language de                      # German
#   transcribe audio.wav -otxt -of /tmp/notes                 # plain text
#   transcribe podcast.mp3 --language en --no-timestamps      # no timestamps
#   transcribe video.mp4 --output-srt --output-file ./out     # named output
#   transcribe video.mp4 --language sr --output-dir ./out    # directed output

set -euo pipefail

MODEL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/occams-agentic/models/whisper"
MODEL="${MODEL_DIR}/ggml-large-v3-turbo.bin"
FLAKE_LOCAL="${OCCAMS_NIXPKGS_LOCAL:-}"
FLAKE_REMOTE="github:nkoturovic/kotur-nixpkgs"
TMP_WAV=""
TMP_MODEL=""

# ─── helpers ──────────────────────────────────────────────────────────────

die()  { echo "ERROR: $*" >&2; exit 1; }

cleanup() {
    [[ -n "${TMP_WAV:-}" ]] && rm -f "$TMP_WAV"
    [[ -n "${TMP_MODEL:-}" ]] && rm -f "$TMP_MODEL"
    return 0
}
trap cleanup EXIT

is_video() {
    case "${1##*.}" in
        wav|mp3|flac|ogg|aac|m4a|opus) return 1 ;;
        *) return 0 ;;
    esac
}

# ─── prerequisites ────────────────────────────────────────────────────────

command -v ffmpeg &>/dev/null || die "ffmpeg not found — required for audio extraction"

# whisper-cli resolution: nix (preferred) → system whisper-cli → fail
HAS_NIX=false
HAS_WHISPER_CLI=false
if command -v nix &>/dev/null; then
    HAS_NIX=true
elif command -v whisper-cli &>/dev/null; then
    HAS_WHISPER_CLI=true
    echo "Using system whisper-cli (nix not found)" >&2
else
    die "Neither nix nor whisper-cli found. Install one: nix (recommended) or build whisper.cpp from source. See https://github.com/ggerganov/whisper.cpp"
fi

if [[ $# -lt 1 ]]; then
    echo "Usage: transcribe <input> [whisper-cli flags...]" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  $0 lecture.mp4                     # auto language, SRT" >&2
    echo "  $0 lecture.mp4 --language de       # German" >&2
    echo "  $0 audio.wav -otxt -of /tmp/out    # plain text" >&2
    echo "  $0 video.mp4 --output-dir ./out    # SRT in directory" >&2
    exit 1
fi

INPUT="$1"; shift
if [[ ! -f "$INPUT" ]]; then
    if [[ "$INPUT" == -* ]]; then
        die "flags must come after the file. Usage: transcribe <file> [flags]"
    fi
    die "file not found: $INPUT"
fi

# ─── model ────────────────────────────────────────────────────────────────

if [[ ! -f "$MODEL" ]]; then
    echo "Downloading whisper model to ${MODEL_DIR} ..." >&2
    mkdir -p "$MODEL_DIR"
    command -v wget &>/dev/null || die "wget not found — required to download whisper model"
    TMP_MODEL="$(mktemp "${MODEL}.tmp.XXXXXX")"
    wget -q --show-progress \
        "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin" \
        -O "$TMP_MODEL"
    mv "$TMP_MODEL" "$MODEL"
    TMP_MODEL=""
    echo "Downloaded: $(du -h "$MODEL" | cut -f1)" >&2
fi

# ─── flake resolution ─────────────────────────────────────────────────────

if [[ -d "$FLAKE_LOCAL/.git" ]]; then
    FLAKE="$FLAKE_LOCAL"
else
    FLAKE="$FLAKE_REMOTE"
fi

# ─── audio extraction (if video) ──────────────────────────────────────────

ORIGINAL_NAME="${INPUT##*/}"
ORIGINAL_NAME="${ORIGINAL_NAME%.*}"

# ─── output directory ────────────────────────────────────────────────────────

OUTPUT_DIR=""
NEW_ARGS=()
SKIP_NEXT=false
for arg in "$@"; do
    if $SKIP_NEXT; then
        if [[ "$arg" == -* ]]; then die "--output-dir requires a directory path (got flag: $arg)"; fi
        OUTPUT_DIR="$arg"
        SKIP_NEXT=false
        continue
    fi
    if [[ "$arg" == "--output-dir" ]]; then
        SKIP_NEXT=true
        continue
    fi
    NEW_ARGS+=("$arg")
done
set -- ${NEW_ARGS[@]+"${NEW_ARGS[@]}"}
if $SKIP_NEXT; then die "--output-dir requires a directory path"; fi
if [[ -n "$OUTPUT_DIR" ]]; then mkdir -p "$OUTPUT_DIR"; fi

if is_video "$INPUT"; then
    TMP_WAV="$(mktemp /tmp/occams-agentic-transcribe-XXXXXX.wav)"
    echo "Extracting audio from: ${INPUT} ..." >&2
    ffmpeg -y -v error -i "$INPUT" -vn -acodec pcm_s16le -ar 16000 -ac 1 "$TMP_WAV"
    INPUT="$TMP_WAV"
fi

# ─── GPU env (platform-aware) ──────────────────────────────────────────────
# Vulkan GPU acceleration (Linux only). macOS uses CoreML via whisper.cpp automatically.
# Override defaults via VK_ICD_FILENAMES env var.
if [[ "$(uname -s)" == "Linux" ]]; then
    # Try common Vulkan ICD paths; user override via env var takes precedence
    if [[ -z "${VK_ICD_FILENAMES:-}" ]]; then
        for icd in \
            /usr/share/vulkan/icd.d/radeon_icd.x86_64.json \
            /usr/share/vulkan/icd.d/nvidia_icd.json \
            /usr/share/vulkan/icd.d/intel_icd.x86_64.json; do
            if [[ -f "$icd" ]]; then
                export VK_ICD_FILENAMES="$icd"
                break
            fi
        done
    fi
    export LD_LIBRARY_PATH="/run/opengl-driver/lib:/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# ─── transcribe ───────────────────────────────────────────────────────────

echo "Transcribing with whisper.cpp ..." >&2

# Build whisper.cpp args.  Output: alongside source video if --output-dir set, else CWD.
WHISPER_ARGS=(-m "$MODEL" -f "$INPUT" --output-srt --print-progress)
HAS_OUTPUT_FILE=false
for arg in "$@"; do
    case "$arg" in
        -of|--output-file|-of=*|--output-file=*) HAS_OUTPUT_FILE=true ;;
    esac
done
if [[ "$HAS_OUTPUT_FILE" == "false" ]]; then
    if [[ -n "$OUTPUT_DIR" ]]; then
        WHISPER_ARGS+=(-of "$OUTPUT_DIR/$ORIGINAL_NAME")
    else
        WHISPER_ARGS+=(-of "$ORIGINAL_NAME")
    fi
fi

# Execute with available whisper-cli
if [[ "$HAS_NIX" == "true" ]]; then
    nix run "${FLAKE}#whisper-cpp-vulkan" -- "${WHISPER_ARGS[@]}" "$@"
    exit $?
elif [[ "$HAS_WHISPER_CLI" == "true" ]]; then
    whisper-cli "${WHISPER_ARGS[@]}" "$@"
    exit $?
fi
